class Vec {
    field int x;
    field int y;
    constructor Vec new(int ax, int ay) {
        let x = ax;
        let y = ay;
        return this;
    }
    method int x() {return x;}
    method int y() {return y;}
    method void add(Vec v) {
        let x = v.x() + x;
        let y = v.y() + y;
        return;
    }
    method void setX(int newX) {
        let x = newX;
        return;
    }
    method void setY(int newY) {
        let y = newY;
        return;
    }
}
